# ─────────────────────────────────────────────────────────────
# TejTaPuff — variables d'environnement
# Copie ce fichier en .env.local pour le dev, et mets les mêmes
# valeurs dans Vercel (Settings → Environment Variables).
# Ne commite JAMAIS de vraies clés.
# ─────────────────────────────────────────────────────────────

# URL publique du site, sans / final. FACULTATIVE sur Vercel (détectée automatiquement).
# À renseigner quand tu brancheras ton domaine : https://tejtapuff.fr (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publishable (sb_publishable_…) ou ancienne clé "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) ou ancienne clé "service_role". SERVEUR UNIQUEMENT.
SUPABASE_SECRET_KEY=

# ── Stripe (Developers → API keys). Commence avec les clés de TEST (sk_test_…) ──
STRIPE_SECRET_KEY=sk_test_
# FACULTATIF : le webhook est créé automatiquement par /api/setup (secret enregistré en base).
# Ne le renseigne que si tu crées le webhook à la main dans Stripe.
STRIPE_WEBHOOK_SECRET=

# ── Resend (emails) ──
RESEND_API_KEY=re_
EMAIL_FROM="TejTaPuff <bonjour@tejtapuff.fr>"

# ── Pixels publicitaires (chargés seulement après consentement cookies) ──
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Admin (étape 4) : seul ce compte aura accès à /admin ──
ADMIN_EMAIL=

# ── Tâche planifiée (Vercel Cron) + clé de la page /api/setup : une longue chaîne aléatoire ──
# Génère-la avec : openssl rand -hex 32
CRON_SECRET=

# ── Coach IA (console.anthropic.com → API Keys) ──
ANTHROPIC_API_KEY=

# ── Notifications : FACULTATIF, les clés sont créées automatiquement par /api/setup ──
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
