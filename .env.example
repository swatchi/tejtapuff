# ─────────────────────────────────────────────────────────────
# TejTaPuff — variables d'environnement
# Copie ce fichier en .env.local pour le dev, et mets les mêmes
# valeurs dans Vercel (Settings → Environment Variables).
# Ne commite JAMAIS de vraies clés.
# ─────────────────────────────────────────────────────────────

# URL publique du site, sans / final (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://tejtapuff.fr

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publishable (sb_publishable_…) ou ancienne clé "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) ou ancienne clé "service_role". SERVEUR UNIQUEMENT.
SUPABASE_SECRET_KEY=

# ── Stripe (Developers → API keys). Commence avec les clés de TEST (sk_test_…) ──
STRIPE_SECRET_KEY=sk_test_
# Secret du webhook (Developers → Webhooks → ton endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_

# ── Resend (emails) ──
RESEND_API_KEY=re_
EMAIL_FROM="TejTaPuff <bonjour@tejtapuff.fr>"

# ── Pixels publicitaires (chargés seulement après consentement cookies) ──
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Admin (étape 4) : seul ce compte aura accès à /admin ──
ADMIN_EMAIL=

# ── Tâches planifiées (Vercel Cron) : une longue chaîne aléatoire ──
# Génère-la avec : openssl rand -hex 32
CRON_SECRET=

# ── Étape 3 (coach IA, notifications) — pas encore utilisées ──
# ANTHROPIC_API_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
